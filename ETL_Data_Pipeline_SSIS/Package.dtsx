      DTS:DTSID="{25FE7682-372A-4035-86D5-AB5BDC949A0A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load New Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0DEDC50C-A990-4585-83FF-0D3F4105C27B}"
          SQLTask:SqlStatementSource="-- Yeni müşterileri ekle&#xA;INSERT INTO DW_SALES.dbo.DimCustomer (CustomerName, City, Country)&#xA;SELECT DISTINCT s.CustomerName, s.City, s.Country&#xA;FROM ERP_DB.dbo.SalesSource s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM DW_SALES.dbo.DimCustomer d&#xA;    WHERE d.CustomerName = s.CustomerName&#xA;      AND d.City = s.City&#xA;      AND d.Country = s.Country&#xA;);&#xA;&#xA;-- Yeni ürünleri ekle&#xA;INSERT INTO DW_SALES.dbo.DimProduct (ProductName, Category, Price)&#xA;SELECT DISTINCT s.ProductName, s.Category, s.Price&#xA;FROM ERP_DB.dbo.SalesSource s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM DW_SALES.dbo.DimProduct d&#xA;    WHERE d.ProductName = s.ProductName&#xA;      AND d.Category = s.Category&#xA;      AND d.Price = s.Price&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
